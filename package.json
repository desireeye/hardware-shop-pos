{
  "name": "hardware-shop",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "build:backend": "npm --workspace backend run build",
    "test:backend": "npm --workspace backend run test",
    "prisma:generate": "npx prisma --schema=./prisma/schema.prisma generate",
    "prisma:migrate": "npx prisma --schema=./prisma/schema.prisma migrate dev --name init",
    "prisma:seed": "tsx ./prisma/seed.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express-rate-limit": "^5.1.3",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
